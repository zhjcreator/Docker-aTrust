# Required. Keep credentials single-quoted so Compose treats '$' literally.
VNC_PASSWORD=''

# Host-side bind addresses default to loopback. Change only the service that
# must be reachable from another trusted device, and add firewall rules.
NOVNC_BIND_ADDR=127.0.0.1
VNC_BIND_ADDR=127.0.0.1
SOCKS_BIND_ADDR=127.0.0.1
HTTP_BIND_ADDR=127.0.0.1
ATRUST_WEB_BIND_ADDR=127.0.0.1

NOVNC_PORT=8080
VNC_PORT=5901
SOCKS_PORT=1080
HTTP_PORT=8888
ATRUST_WEB_PORT=54631

# Optional SOCKS5 authentication. Set both values or leave both empty.
SOCKS_USER=''
SOCKS_PASSWD=''
